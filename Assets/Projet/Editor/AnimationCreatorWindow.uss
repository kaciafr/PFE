/* Style "iOS dark" pour Animation Creator */

.root {
    flex-grow: 1;
    padding: 18px 16px;
    background-color: rgb(0, 0, 0);
}

.title {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin: 0 0 2px 2px;
}

.subtitle {
    font-size: 12px;
    color: rgb(142, 142, 147);
    margin: 0 0 8px 2px;
}

.section-header {
    font-size: 11px;
    color: rgb(142, 142, 147);
    margin: 14px 0 6px 14px;
}

/* ---- Cartes groupées ---- */
.card {
    background-color: rgb(28, 28, 30);
    border-radius: 12px;
    overflow: hidden;
}

.row {
    flex-direction: row;
    align-items: center;
    min-height: 42px;
    padding: 0 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(56, 56, 58);
}

.row--last {
    border-bottom-width: 0;
}

.row-label {
    width: 112px;
    font-size: 13px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
}

.row-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
}

.row-field .unity-base-text-field__input,
.row-field .unity-object-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(174, 174, 178);
    -unity-text-align: middle-right;
}

.row-field .unity-object-field-display__label {
    color: rgb(174, 174, 178);
}

/* ---- Champ du nom ---- */
.name-field {
    margin: 0;
    padding: 4px 8px;
}

.name-field .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    font-size: 15px;
    color: rgb(255, 255, 255);
}

/* ---- Boutons ---- */
.primary-button {
    height: 46px;
    margin: 20px 0 8px 0;
    border-width: 0;
    border-radius: 12px;
    background-color: rgb(10, 132, 255);
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.primary-button:hover {
    background-color: rgb(64, 156, 255);
}

.primary-button:active {
    background-color: rgb(0, 102, 214);
    scale: 0.98 0.98;
}

.secondary-button {
    height: 40px;
    margin: 0;
    border-width: 0;
    border-radius: 12px;
    background-color: rgb(28, 28, 30);
    color: rgb(10, 132, 255);
    font-size: 14px;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.secondary-button:hover {
    background-color: rgb(44, 44, 46);
}

.secondary-button:active {
    scale: 0.98 0.98;
}

.icon-button {
    width: 30px;
    height: 24px;
    margin: 0 0 0 6px;
    border-width: 0;
    border-radius: 8px;
    background-color: rgb(58, 58, 60);
    color: rgb(255, 255, 255);
}

.icon-button:hover {
    background-color: rgb(72, 72, 74);
}

/* ---- Statut ---- */
.status {
    margin-top: 14px;
    padding: 10px 12px;
    border-radius: 12px;
    background-color: rgba(10, 132, 255, 0.15);
}

.status-label {
    white-space: normal;
    font-size: 12px;
    color: rgb(100, 180, 255);
}

.status--ok { background-color: rgba(48, 209, 88, 0.15); }
.status--ok .status-label { color: rgb(48, 209, 88); }

.status--warn { background-color: rgba(255, 159, 10, 0.15); }
.status--warn .status-label { color: rgb(255, 159, 10); }

.status--error { background-color: rgba(255, 69, 58, 0.15); }
.status--error .status-label { color: rgb(255, 69, 58); }

/* ---- Grandes icônes pour Prefab / Scène ---- */
.row--tall {
    min-height: 56px;
}

.row--tall .unity-object-field-display__icon {
    width: 32px;
    height: 32px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.row--tall .unity-object-field-display__label {
    font-size: 13px;
}
